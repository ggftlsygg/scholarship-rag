renderer=\"svg\"></div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</header>\n\n\n<div class=\"overlayer overlayer--menu\">\n    <div class=\"overlayer__inner overlayer__inner--menu fx-margin\">\n        <div class=\"overlayer__content\">\n            <ul class=\"overlayer__menu\" role=\"navigation\">\n                <li>\n                    <a href=\"/about\" class=\"overlayer__menu-item js-animation-title\" tabindex=\"-1\"\n                        aria-hidden=\"true\">About</a>\n                </li>\n                <li>\n                    <a href=\"/work/\" class=\"overlayer__menu-item js-animation-title\" tabindex=\"-1\"\n                        aria-hidden=\"true\">Work</a>\n                </li>\n                <li>\n                    <a href=\"/people\" class=\"overlayer__menu-item js-animation-title\" tabindex=\"-1\"\n                        aria-hidden=\"true\">People</a>\n                </li>\n                <li>\n                    <a href=\"/ideas/\" class=\"overlayer__menu-item js-animation-title\" tabindex=\"-1\"\n                        aria-hidden=\"true\">Ideas</a>\n                </li>\n                <li>\n                    <a href=\"/careers/\" class=\"overlayer__menu-item js-animation-title\" tabindex=\"-1\"\n                        aria-hidden=\"true\">Careers</a>\n                </li>\n                <li>\n                    <a href=\"/contact\" class=\"overlayer__menu-item js-animation-title\" tabindex=\"-1\"\n                        aria-hidden=\"true\">Contact</a>\n                </li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"overlayer__inner overlayer__inner--search fx-margin overlayer__inner--hidden\">\n        <form action=\"/search\" method=\"get\" class=\"form-search\" autocomplete=\"off\" autocorrect=\"off\">\n    <input type=\"search\" name=\"q\" value=\"\" class=\"form-search__input\" placeholder=\"Search\">\n    </form>\n        <div class=\"search-content\"></div>\n    </div>\n</div>\n\n<div class=\"overlayer overlayer--submenu\"></div>\n\n\n<main class=\"main\">\n\t<div class=\"main__content main__content--no-space\">\n\n\n        <div class=\"layer layer--fixed fx-hide-on-mobile\">\n            <div class=\"layer__wrap\">\n                <div class=\"layer__content\">\n\n                    <div class=\"page-hero\">\n                        <div class=\"lazyload-container page-hero__image\">\n                            <img class=\"js-lazyload lazyimage js-wait-for-heroimage\" data-src=\"/images/D24171_00_N574_printmedium.jpg?w=1600\" data-srcset=\"/images/D24171_00_N574_printmedium.jpg?w=100 100w,/images/D24171_00_N574_printmedium.jpg?w=200 200w,/images/D24171_00_N574_printmedium.jpg?w=300 300w,/images/D24171_00_N574_printmedium.jpg?w=400 400w,/images/D24171_00_N574_printmedium.jpg?w=500 500w,/images/D24171_00_N574_printmedium.jpg?w=640 640w,/images/D24171_00_N574_printmedium.jpg?w=750 750w,/images/D24171_00_N574_printmedium.jpg?w=828 828w,/images/D24171_00_N574_printmedium.jpg?w=1024 1024w,/images/D24171_00_N574_printmedium.jpg?w=1125 1125w,/images/D24171_00_N574_printmedium.jpg?w=1242 1242w,/images/D24171_00_N574_printmedium.jpg?w=1280 1280w,/images/D24171_00_N574_printmedium.jpg?w=1400 1400w,/images/D24171_00_N574_printmedium.jpg?w=1500 1500w,/images/D24171_00_N574_printmedium.jpg?w=1600 1600w,/images/D24171_00_N574_printmedium.jpg?w=1700 1700w,/images/D24171_00_N574_printmedium.jpg?w=1800 1800w,/images/D24171_00_N574_printmedium.jpg?w=1920 1920w\" data-sizes=\"auto\" alt=\"\" src=\"\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n         <div class=\"layer layer--pinnable\">\n            <div class=\"js-layer-pin\">\n                <div class=\"layer__wrap js-animate-width\">\n                    <div class=\"layer__content\">\n\n                        <div class=\"block block--title block--no-space\">\n                            <div class=\"block__content fx-margin\">\n                                <h1>Scholarships</h1>\n                            </div>\n                        </div>\n\n                        <div class=\"block block--text block--text-large block--no-space\">\n                            <div class=\"block__content fx-grid fx-margin\">\n                                <div class=\"block-text fx-format-text\">\n                                    <p>We are committed to mentoring students and training the next generation of leaders.&nbsp;</p>\r\n\n                                </div>\n                            </div>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"layer layer--pinnable\">\n            <div class=\"js-layer-pin\">\n                <div class=\"layer__wrap\" style=\"background: #e6e6e6\">\n                    <div class=\"layer__content\">\n                        <div class=\"block block--text\">\n                            <div class=\"block__content fx-grid fx-margin\">\n                                <article class=\"block-text fx-format-text\">\n                                    <h1>Norm Zimmer Scholarship</h1>\n\n                                    <p>Established in 2004, in memory of ZGF founding partner Norm Zimmer, the Norm Zimmer Scholarship exemplifies Norm\u2019s spirit and devotion to design, community, and lifelong learning. With this guiding ethos in mind, each year one student is selected to receive $10,000 for university tuition and fees.</p>\r\n\r\n<p>ZGF is committed to supporting the next generation of designers and we encourage all interested applicants across Architectural, Interior, Urban, or Landscape Design to apply. We are looking for students who display a commitment to their craft and a dedication to personal development in their chosen field.</p>\r\n\n                                </article>\n                            </div>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"layer layer--pinnable layer--right\" style=\"background: #e6e6e6\">\n            <div class=\"layer__wrap\">\n               <div class=\"layer__content\">\n                    <div class=\"block block--text\">\n                        <div class=\"block__content fx-grid fx-margin\">\n                            <div class=\"block-text fx-format-text\">\n                                <h2>Details and Requirements</h2>\r\n\r\n<h3>ELIGIBILITY</h3>\r\n\r\n<p>Current students enrolled in an accredited architecture (NAAB), interior design (CIDA), urban planning and design (PAB), or landscape architecture (LAAB) program in the United States who will begin their final year in an accredited program in 2027. Valid graduation dates from your current program can include both winter (December) of 2027&nbsp;or spring (April / May) of 2028.</p>\r\n\n\n                                <div class=\"text-columns\">\n                                    <div class=\"text-column\">\n                                        <h3>MATERIALS</h3>\r\n\r\n<h4>1. Online Application</h4>\r\n\r\n<h4>2. Resume</h4>\r\n\r\n<h4>3. Academic Portfolio</h4>\r\n\r\n<p>-Include (5) examples of academic design work with written descriptions&nbsp;(5 projects maximum).&nbsp;All examples (conceptual sketches, three-dimensional views, etc.) should be produced in a manner that is readable and legible.<br />\r\n-Original work is preferred.&nbsp;Work done with a single partner may be submitted, but it must include a description of the applicant\u2019s specific contribution.<br />\r\n-Acceptable formats: Upload (1) file with projects combined in a single PDF&nbsp;(max 9MB file&nbsp;size)<em>,</em>&nbsp;or a link to online portfolio in format stated above.&nbsp;</p>\r\n\r\n<h4>4. One page essay</h4>\r\n\r\n<p>Please describe how you hope to positively impact the world through design&nbsp;(1 page maximum).</p>\r\n\r\n<h4>5. Letter of Recommendation</h4>\r\n\r\n<p>Written by a faculty member of your current institution with direct knowledge of your work, addressing your talent, and passion for the field of architecture and design.</p>\r\n\r\n<h4>6. Finalist Video Submission in Early to Mid-February</h4>\r\n\r\n<p>Finalists will be notified to submit a personal 3-minute video introducing themselves to the judges.</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><em>ZGF Architects LLP in partnership with the Oregon Community Foundation</em></p>\r\n\n                                    </div>\n\n                                    <div class=\"text-column\">\n                                        <h3>IMPORTANT DATES</h3>\r\n\r\n<h4>November 2, 2026</h4>\r\n\r\n<p>Scholarship portal opens</p>\r\n\r\n<h4>January 10, 2027</h4>\r\n\r\n<p>Scholarship portal closes at 11:59pm PST &nbsp;&nbsp;&nbsp;</p>\r\n\r\n<h4>Spring 2027</h4>\r\n\r\n<p>Winner notified</p>\r\n\r\n<h4>Fall 2027</h4>\r\n\r\n<p>Scholarship fund distributed to University to be applied toward tuition and fees</p>\r\n\n                                    </div>\n                                </div>\n\n                                <a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Fzgfarchitects.applytojob.com%2Fapply%2FD1Lc9VSI0S%2F2027-Norm-Zimmer-Scholarship&amp;data=05%7C02%7Cclaire.chancey%40zgf.com%7C55d8a789108e464a139708df40e01ad7%7C9515471981f140739ca6f8adfb\" class=\"button\">Apply now</a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n\n        <div class=\"layer layer--pinnable\" style=\"background: #f0f0f0\">\n            <div class=\"js-layer-pin\">\n                <div class=\"layer__wrap\" style=\"background: #e6e6e6\">\n                    <div class=\"layer__content\">\n                        <div class=\"block block--text\">\n                            <div class=\"block__content fx-grid fx-margin\">\n                                <article class=\"block-text fx-format-text\">\n                                    <h1>Emerging Black Architects and Designers Scholarship</h1>\n\n                                    <p>ZGF proudly presents the 7th year of our Emerging&nbsp;Black Architects and Designers&nbsp;scholarship to support Black students currently enrolled in Architecture and Design programs in the US.&nbsp;</p>\r\n\r\n<p>Two (2) students will be selected to each receive a $5,000 scholarship&nbsp;to go toward their&nbsp;final year of schooling.</p>\r\n\n                                </article>\n                            </div>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"layer layer--pinnable layer--right\" style=\"background: #e6e6e6\">\n            <div class=\"layer__wrap\">\n               <div class=\"layer__content\">\n                    <div class=\"block block--text\">\n                        <div class=\"block__content fx-grid fx-margin\">\n                            <div class=\"block-text fx-format-text\">\n                                <h2>Details and Requirements</h2>\r\n\r\n<h3>ELIGIBILITY</h3>\r\n\r\n<p>Students must submit an online application that includes a resume, an essay, one advanced level design project, and one letter of recommendation. Applicants must be currently enrolled and entering their final year of an accredited architecture (NAAB), interior design (CIDA), urban planning and design (PAB), or landscape architecture (LAAB) program in the United States and entering their final year in an accredited program in 2027. Valid graduation dates from your current program can include both winter (December) of 2027&nbsp;or spring (April / May) of 2028.&nbsp;</p>\r\n\n\n                                <div class=\"text-columns\">\n                                    <div class=\"text-column\">\n                                        <h3>MATERIALS</h3>\r\n\r\n<h4>1. Online Application</h4>\r\n\r\n<h4>2. Resume</h4>\r\n\r\n<h4>3. One Advanced Level Design Project</h4>\r\n\r\n<p>-One project limited to (5) pages maximum with a written description of the project (250 words).<br />\r\n-Individual work is highly preferred.<br />\r\n-Work done with a single partner may be submitted, and&nbsp;it must include a description of the applicant\u2019s specific contribution and a letter of support from the applicant\u2019s collaborative partner.<br />\r\n-Preferred layout is 11x17 landscape.<br />\r\n-Acceptable formats: Upload (1) file in a single PDF <em>(max 9MB file&nbsp;size),</em>&nbsp;or a link to online portfolio in format stated above.</p>\r\n\r\n<h4>4. One page essay</h4>\r\n\r\n<p>Please describe how you will impact your community through your unique&nbsp;lived experience and as a design professional&nbsp;(500 words maximum).</p>\r\n\r\n<h4>5. Letter of Recommendation</h4>\r\n\r\n<p>Written by a faculty member of your current institution with direct knowledge of your work, addressing your talent, and passion for the field of architecture and design.</p>\r\n\r\n<h4>5. Finalist Video Submission&nbsp;in February</h4>\r\n\r\n<p>Finalists&nbsp;will be invited to&nbsp;submit a personal 3-minute video introducing themselves to the judges and presenting their project.</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><em>ZGF Architects LLP in partnership with the Oregon Community Foundation</em></p>\r\n\n                                    </div>\n\n                                    <div class=\"text-column\">\n                                        <h3>IMPORTANT DATES</h3>\r\n\r\n<h4>November 2, 2026</h4>\r\n\r\n<p>Scholarship portal opens</p>\r\n\r\n<h4>January 10, 2027</h4>\r\n\r\n<p>Scholarship portal closes at 11:59pm PST</p>\r\n\r\n<h4>Spring 2027</h4>\r\n\r\n<p>Winner notified</p>\r\n\r\n<h4>Fall 2027</h4>\r\n\r\n<p>Scholarshi