{"url": "https://www.ru.nl/en/education/scholarships/individual-travel-grant", "html": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\" prefix=\"og: https://ogp.me/ns#\">\n<head>\n  <meta charset=\"utf-8\" />\n<noscript><style>form.antibot > * { display: none !important; } form.antibot noscript { display: block !important; }</style>\n</noscript><meta name=\"description\" content=\"Students who are not eligible for an Erasmus grant or a Holland Scholarship might apply for a grant from the Radboud University Student Support Regulation.\" />\n<meta name=\"keywords\" content=\"individual travel grant, irs, profiling fund, studying abroad, student support regulation\" />\n<link rel=\"canonical\" href=\"https://www.ru.nl/en/education/scholarships/individual-travel-grant\" />\n<meta name=\"robots\" content=\"index\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:url\" content=\"https://www.ru.nl/en/education/scholarships/individual-travel-grant\" />\n<meta property=\"og:title\" content=\"Individual Travel Grant | Radboud University\" />\n<meta property=\"og:description\" content=\"Students who are not eligible for an Erasmus grant or a Holland Scholarship might apply for a grant from the Radboud University Student Support Regulation.\" />\n<meta property=\"og:image\" content=\"https://www.ru.nl/radboud-universiteit-open-graph-logo.png\" />\n<meta property=\"og:image:width\" content=\"1200\" />\n<meta property=\"og:image:height\" content=\"600\" />\n<meta name=\"google-site-verification\" content=\"K-xcLqpFSjIACwdXWxpc4Q8Fnk8ju7dlN3_klA-2y3g\" />\n<meta name=\"Generator\" content=\"Drupal 11 (https://www.drupal.org)\" />\n<meta name=\"MobileOptimized\" content=\"width\" />\n<meta name=\"HandheldFriendly\" content=\"true\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<link rel=\"icon\" href=\"/core/misc/favicon.ico\" type=\"image/vnd.microsoft.icon\" />\n<link rel=\"alternate\" hreflang=\"nl\" href=\"https://www