menu-useful-links-&amp;-resources\"><a href=\"/resources/useful-links-additional-materials\">Useful Links &amp; Resources</a></li>\n</ul></div>\n    </div>\n  </div>\n</nav>\n\n  </div>\n</div>\n  </div>\n</div>\n  </div>\n</div>  </div>\n</main>\n  \n      <footer id=\"section-footer\" class=\"section section-footer\" role=\"contentinfo\">\n  <div id=\"zone-footer-wrapper\" class=\"zone-wrapper zone-footer-wrapper clearfix\">  <div id=\"zone-footer\" class=\"zone zone-footer clearfix container-12\">\n    <div  class=\"grid-2 region region-footer-first\" id=\"region-footer-first\">\n  <div  class=\"region-inner region-footer-first-inner\">\n    <div class=\"footer-logo\"><a href=\"http://www.yale.edu\" class=\"y-icons y-yale y-mark\"><span class=\"element-invisible\">Yale</span></a></div>\n  </div>\n</div>\n<div  class=\"grid-6 region region-footer-second\" id=\"region-footer-second\">\n  <div class=\"region-inner region-footer-second-inner\">\n    <p class=\"copyright spacer\">\n      <a href=\"https://usability.yale.edu/web-accessibility/accessibility-yale\">Accessibility at Yale</a> &middot;\n      <a href=\"http://www.yale.edu/privacy-policy\">Privacy policy</a> <br>\n      Copyright &copy; 2026 Yale University &middot; All rights reserved\n    </p>\n      </div>\n</div>\n<div class=\"grid-4 region region-footer-third\" id=\"region-footer-third\">\n  <div class=\"region-inner region-footer-third-inner\">\n    <div class=\"block block-menu block-menu-social-buttons block-menu-menu-social-buttons odd block-without-title\" id=\"block-menu-menu-social-buttons\">\n  <div class=\"block-inner clearfix\">\n            \n    <div class=\"content clearfix\">\n      <ul class=\"menu\"><li class=\"first leaf menu-facebook\"><a href=\"https://www.facebook.com/yaleyoungafricanscholars/\" class=\"fa fa-facebook-square\"><span>Facebook</span></a></li>\n<li class=\"leaf menu-twitter\"><a href=\"https://twitter.com/YaleYoungAfrica\" class=\"fa fa-twitter\"><span>Twitter</span></a