 \n        \n    \">\n                                                                                                            <div class=\"hero__wrapper w-full relative\">\n    <div class=\"hero__primary-image w-full flex content-end aspect-[3/1] lg:h-hero-small lg:max-h-hero-small bg-cover bg-center relative\" style=\"background-image: url('/promos/1606/UPW_WSU-CONVO-FEST_20210831_082.jpg')\">\n            </div>\n</div>                                                                                    </div>\n\n            \n    <main class=\"layout layout--left-menu\"\n    tabindex=\"-1\">\n\n        <nav id=\"menu\" class=\"page-menu \" aria-label=\"Page menu\" tabindex=\"-1\">\n    \n                    <div class=\"slideout-main-menu mt:hidden\">\n                <ul class=\"main-menu mb-2\">\n                    <li>\n                        <a role=\"button\"\n                           class=\"main-menu-toggle pt-2 pb-2 pl-3 pr-3 block\"\n                           tabindex=\"0\"\n                           aria-expanded=\"false\"\n                           >Main menu</a>\n                        <ul class=\"menu-top\"><li><a href=\"/about\">About</a></li>\n<li><a href=\"/admissions\">Admissions and aid</a></li>\n<li><a href=\"/programs\">Programs</a></li>\n<li><a href=\"/campus\">Campus</a></li>\n<li><a href=\"https://research.wayne.edu\">Research</a></li>\n<li><a href=\"/students\">Students</a></li>\n<li><a href=\"https://wsuathletics.com/\">Athletics</a></li>\n<li><a href=\"https://library.wayne.edu/\">Libraries</a></li>\n<li class=\"hide-for-xlarge-up hide-for-print mt:!hidden\"><a href=\"https://login.wayne.edu/\">Login</a></li>\n<li class=\"hide-for-xlarge-up hide-for-print mt:!hidden\"><a href=\"https://giving.wayne.edu/donate\">Make a gift</a></li>\n</ul>\n                    </li>\n                </ul>\n            </div>\n            \n    <div class=\"page-menu__label\">Financial Aid</div>\n            <ul class=\"main-menu\"><li><a href=\"/financial-aid/applying\">Applying for aid</a></li>\n<li class=\"selected\"><a href=\"/financial-aid/types\">Types of aid</a><ul><li><a href=\"/financial-aid/types/wayne-state-guarantee\">Wayne State Guarantee</a></li>\n<li><a href=\"/financial-aid/types/grants\">Grants</a></li>\n<li><a href=\"/scholarships/\">Scholarships</a></li>\n<li class=\"selected\"><a href=\"/financial-aid/types/mas\">Michigan Achievement Scholarship</a></li>\n<li><a href=\"/financial-aid/types/pledge\">Tuition pledge programs</a></li>\n<li><a href=\"/financial-aid/types/work-study\">Work-Study</a></li>\n<li><a href=\"/financial-aid/types/loans\">Loans</a></li>\n<li><a href=\"/financial-aid/types/other\">Other types of aid</a></li>\n<li><a href=\"/financial-aid/financial-aid/types/glance\">Financial aid at a glance</a></li>\n</ul></li>\n<li><a href=\"/financial-aid/receiving\">Receiving your aid</a></li>\n<li><a href=\"/financial-aid/forms\">Forms and policies</a></li>\n<li><a href=\"/financial-aid/resources\">Resources</a></li>\n<li><a href=\"/financial-aid/contact\">Contact us</a></li>\n</ul>\n    \n    \n    \n    </nav>\n\n        <div id=\"content\" class=\"content-area\" tabindex=\"-1\">\n            <div class=\"page-content\">\n                <div class=\"page-content__container\">\n                    <nav id=\"breadcrumbs-menu\" class=\"breadcrumbs\" aria-label=\"Breadcrumbs\">\n    <ul class=\"text-sm \">\n                                    <li class=\"inline\">\n                    <a href=\"/\" aria-labelledby=\"home\"><span class=\"text-black align-middle\"><svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"18\" viewBox=\"0 0 30 32\" class=\"w-4 h-4 inline align-baseline\" aria-labelledby=\"home\">\n    <title id=\"home\">home</title>\n    <path d=\"M25.152 17.728v8.544q0 0.48-0.352 0.8t-0.8 0.352h-6.848v-6.848h-4.576v6.848h-6.848q-0.48 0-0.8-0.352t-0.352-0.8v-8.544q0-0.032 0-0.064t0-0.064l10.272-8.448 10.272 8.448q0.032 0.032 0.032 0.128zM29.12 16.48l-1.088 1.312q-0.16 0.16-0.384 0.192h-0.064q-0.224 0-0.384-0.096l-12.352-10.304-12.352 10.304q-0.224 0.128-0.416 0.096-0.224-0.032-0.384-0.192l-1.12-1.312q-0.128-0.192-0.096-0.416t0.192-0.384l12.832-10.688q0.576-0.48 1.344-0.48t1.376 0.48l4.352 3.616v-3.456q0-0.256 0.16-0.416t0.416-0.16h3.424q0.256 0 0.416 0.16t0.16 0.416v7.264l3.904 3.264q0.192 0.128 0.192 0.384t-0.128 0.416z\"></path>\n</svg>\n</span></a>\n                    <span class=\"icon-right-open px-2\"></span>\n                        </li>\n                                    <li class=\"inline\">\n                <a href=\"/financial-aid\" class=\"text-green hover:underline\">Financial Aid</a>\n                <span class=\"icon-right-open px-2\"></span>\n                        </li>\n                                    <li class=\"inline\">\n                <a href=\"/financial-aid/types\" class=\"text-green hover:underline\">Types of aid</a>\n                <span class=\"icon-right-open px-2\"></span>\n                        </li>\n                                    <li class=\"font-bold text-green inline\">\n                    Michigan Achievement Scholarship\n                        </li>\n            </ul>\n</nav>\n                        <h1 class=\"page-title \">\n        Michigan Achievement Scholarship\n    </h1>\n\n    <div class=\"content\">\n    <p>The State of Michigan offers the\u00a0<a href=\"https://www.michigan.gov/mistudentaid/programs/michigan-achievement-scholarship/college-and-university\" rel=\"noopener noreferrer\" target=\"_blank\">Michigan Achievement Scholarship</a> for eligible undergraduates.\u00a0\u00a0</p> <h2>Award amount</h2> <ul> <li>The award maximum is $5,500 each academic year and is renewable for up to five years.</li> <li>You must be\u00a0enrolled full time (12 or more credit hours) to receive the award.</li> </ul> <h2>Eligibility requirements for new students in the 2026-27 academic year</h2> <ul> <li>This award is for incoming first-year undergraduates who are Michigan residents admitted for the 2026-27 academic year in a degree program. You must be a Michigan resident since July 1, 2025. If you are a dependent student, your parent(s) must also be a Michigan resident since July 1, 2025.</li> <li>Graduate from high school with a diploma or a certificate of completion or achieved a high school equivalency certificate in 2023 or after and enroll within 15 months.</li> <li>File the annual FAFSA by the state deadline and demonstrate financial need with a FAFSA Student Aid Index (SAI) of 30,000 or less.</li> </ul> <h2>Eligibility for transfer students</h2> <p>Transfer students will be reviewed for an award if you meet the FAFSA and state residency requirements. You must have graduated from high school with a diploma or a certificate of completion or achieved a high school equivalency certificate in 2023 or after and enroll in college within 15 months.\u00a0\u00a0After you file the annual FAFSA, indicate you will attend WSU in the <a href=\"https://missg.guarantorsolutions.com/StudentPortal\">State Student Portal</a>.</p> <h2>To retain eligibility</h2> <ul> <li>Meet all\u00a0<a href=\"/financial-aid/retaining/sap/\" rel=\"noopener noreferrer\" target=\"_blank\">Satisfactory Academic Progress</a>\u00a0requirements.</li> <li>Continue to file the annual FAFSA.</li> </ul> <h2>Other awards</h2> <p>The Michigan Achievement Scholarship will be applied to tuition &amp; fees up to the lowest rate charged WSU undergraduates. For students in WSU pledge programs, WSU will ensure that their actual in-state tuition and standard fees will be covered with a combination of funding that includes federal, state,\u00a0and WSU scholarships and grants.</p>\n</div>\n                </div>\n            </div>\n        </div>\n\n        \n            </main>\n\n    </div>\n\n<footer>\n    \n            <div class=\"bg-gold-50\">\n        <div class=\"row lg:grid grid-cols-3 py-8\">\n                                                <div class=\"p-4 \">\n                        <h2 class=\"text-green mb-1\">Address</h2>\n                        <div class=\"content text-green print:text-black\">\n                            <p><strong>Office of<br />Student Financial Aid</strong></p>    <p>The Welcome Center<br />  42 W. Warren Avenue<br />  P.O. Box 2340<br />  Detroit, MI 48202-0340 (<a href=\"http://maps.wayne.edu/view/#welcome-center\">map</a>)</p>  \n                        </div>\n                    </div>\n                                                                <div class=\"px-4 py-4 border-t lg:border-l lg:border-0 border-gold-200\">\n                        <h2 class=\"text-green mb-1\">Phone/Email</h2>\n                        <div class=\"content text-green print:text-black\">\n                            <div><a href=\"mailto:OneStop@wayne.edu\" target=\"_blank\" rel=\"noreferrer noopener\">OneStop@wayne.edu</a></div>\n\n<div>Tel: 313-577-2100<br />\nFax: 313-577-6648</div>\n\n<div>\u00a0</div>\n\n<div>School of Medicine:</div>\n\n<div>finaidmed@wayne.edu</div>\n\n<div>313-577-1466<br />\n\u00a0</div>\n\n                        </div>\n                    </div>\n                                                                <div class=\"px-4 py-4 border-t lg:border-l lg:border-0 border-gold-200\">\n                        <h2 class=\"text-green mb-1\">Hours</h2>\n                        <div class=\"content text-green print:text-black\">\n                            <p>Monday - Friday<br />  9:00 a.m. - 5:00 p.m.</p>    <p>School of Medicine:<br />  Monday - Friday<br />  8:30 a.m. - 5:00 p.m.</p>    <p>&nbsp;</p>  \n                        </div>\n                    </div>\n                                    </div>\n    </div>\n    \n            <div class=\"bg-green-700 py-6 print:hidden\">\n    <div class=\"row flex flex-wrap md:flex-nowrap justify-center items-center\">\n                    <a href=\"https://twitter.com/waynestate\" target=\"_blank\" aria-labelledby=\"x\" rel=\"noop