  </li>\n                    </ol>\n    <!-- MOBILE -->\n\n    <ol id=\"breadcrumb-mobile\" class=\"visible-xs breadcrumb bg-white pull-left px-0 mb-0 \">\n                                                                        <li class=\"breadcrumb-item\"  title=\"Modified:            2014-02-28\">\n            <a href=\"/en/scholarship+programmes+for+gifted+students/50637.html\" title=\"Scholarship Programmes for Gifted Students\">Scholarship Programmes for Gifted Students</a>\n        </li>\n                                    </ol>\n\n    <div class=\"pull-right py-4 text-uppercase\">\n    <!--\n        <a id=\"chatAI-button\" class=\"hidden-xs mr-4\" role=\"button\" href=\"/chatai-fullpage\">\n                            <span class=\"fas fa-brain\"></span> Ask ChatAI 2\n                    </a>\n        <a id=\"chatAI-button\" class=\"hidden-xs mr-4\" role=\"button\" data-toggle=\"collapse\" href=\"#chatai-popup\"\n            aria-expanded=\"false\" aria-controls=\"chatAI-popup\">\n                            <span class=\"fas fa-brain\"></span> Ask ChatAI\n                    </a>-->\n        <a id=\"search-button\" class=\"hidden-xs mr-4\" role=\"button\" data-toggle=\"collapse\" href=\"#search-content\"\n            aria-expanded=\"false\" aria-controls=\"search-content\">\n                            <span class=\"fas fa-search\"></span> Search\n                    </a>\n                        <a class=\"lang-button\"\n            href=\"/de/61292.html\">\n            <span class=\"fas fa-globe\"></span> Deutsch\n        </a>\n                    </div>\n\n    </div>\n</nav>\n    <div id=\"main\">\n      <div class=\"container-fluid\">\n\n        <div id=\"page-content\" class=\"row\">\n          <article class=\"col-sm-8\">\n            <!-- Language Warning -->\n                        <!-- Inhalt  -->\n                      \t\t<h1 class=\"headline\">Cusanuswerk (self-portrayal)</h1>\n          \t\t          \t\t  <p class=\"text\">Cusanuswerk is the scholarship funding organisation of the Catholic Church in the Federal Republic of Germany. Sponsored by the Catholic Church, it awards scholarships funded by the government and as well as the Church to exceptionally gifted Catholic students of all subject areas. For more than 50 years, Cusanuswerk has also offered its scholarship recipients a comprehensive programme of education and provided opportunities for intensive personal guidance of scholarship holders. The aim is to enable scholarship recipients to discover their own capabilities for taking on responsibility in the world of tomorrow in dialogue between art, science and religious faith.<br />\r\n<br />\r\n<br />\r\n<span style=\"color:grey;font-size:larger\"><b>Application</span></b><br />\r\n<br />\r\n<a href=\"http://www.cusanuswerk.de/en/home/welcome/\" target=\"_blank\">Cusanuswerk - Bisch\u00f6fliche Studienf\u00f6rderung</a><br />\r\n<br />\r\n<br />\r\n<b>Liaison lecturer at G\u00f6ttingen University:</b><br />\r\n<br />\r\nProf. Dr. Lorenz Tr\u00fcmper<br />\r\nMedical Faculty<br />\r\nRobert-Koch-Stra\u00dfe 40<br />\r\n37075 G\u00f6ttingen<br />\r\nPhone: +49 (0)551/ 39-8535<br />\r\n<a href=\"mailto:lorenz.truemper@med.uni-goettingen.de\">lorenz.truemper@med.uni-goettingen.de</a><br /></p>\n          \t\t          \t\n\t\t<!-- Unterseiten -->\n\n\t\t\n          </article>\n          <!-- Rechte Sidebar -->\n          <aside class=\"col-sm-4\">\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t<!-- Sidebar Bild -->\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<!-- Html Inhalt f\ufffdr Sidebar -->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"box\">\n\t\t\t\t\t\t\t\t\t<p class=\"text\"><b>Contact</b><br />\r\nCusanuswerk<br />\r\nBaumschulallee 5<br />\r\nD-53115 Bonn<br />\r\nTel: +49 (0)228/ 98384-0<br />\r\nFax: +49 (0)228/ 98384-99<br />\r\n<a href=\"mailto:info@cusanuswerk.de\">info@cusanuswerk.de</a></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t          </aside>\n        </div>\n      </div><!-- Ende container-fluid -