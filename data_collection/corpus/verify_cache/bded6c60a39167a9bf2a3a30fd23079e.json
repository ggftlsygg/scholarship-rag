li>\n                          <li>\n                  <a href=\"/cdc/resources/non-imu-grants\" data-drupal-link-system-path=\"node/13290\">Non IMU Grants</a>\n                  </li>\n                          <li>\n                  <a href=\"/cdc/resources/online-resources\" data-drupal-link-system-path=\"node/13292\">Online Resources</a>\n                  </li>\n                          <li>\n                  <a href=\"/cdc/resources/cdc-webinars\" data-drupal-link-system-path=\"node/15914\">CDC Webinars</a>\n                  </li>\n          </ul>\n\n                  </li>\n                          <li class=\"has-children\">\n                  <a href=\"/cdc/mathematical-talent-universal-funding-not\" data-drupal-link-system-path=\"node/15864\">Support Us</a>\n                            <ul class=\"main-navigation__dropdown js-dropdown mlevel-1\">\n                          <li>\n                  <a href=\"/cdc/mathematical-talent-universal-funding-not\" data-drupal-link-system-path=\"node/15864\">Donate </a>\n                  </li>\n          </ul>\n\n                  </li>\n          </ul>\n\n\n\n\n  </nav>\n<div  class=\"search block-imuheadersearchform-2 block block-search container-inline js-search--imu\" id=\"block-imuheadersearchform-2\">\n  \n    \n      <form class=\"imu-header-search-form\" data-drupal-selector=\"imu-header-search-form\" action=\"/cdc/grants/AVSP\" method=\"post\" id=\"imu-header-search-form\" accept-charset=\"UTF-8\">\n  <div class=\"js-form-item form-item js-form-type-search form-item-keys js-form-item-keys form-no-label\">\n        <input placeholder=\"Your search\" data-drupal-selector=\"edit-keys\" type=\"search\" id=\"edit-keys\" name=\"keys\" value=\"\" size=\"60\" maxlength=\"128\" class=\"form-search required\" required=\"required\" autocomplete=\"off\" />\n\n        </div>\n<input data-drupal-selector=\"edit-search-submit\" type=\"submit\" id=\"edit-search-submit\" name=\"op\" value=\"Search\" class=\"button js-form-submit form-submit\" />\n<input autocomplete=\"off\" data-drupal-selector=\"form-nbkdz-aws2oa0-fez-gmcdurzt5v07qdxt-fosjckki\" type=\"hidden\" name=\"form_build_id\" value=\"form-nBkdZ-Aws2oA0-fEz-gmcduRzT5v07QdxT_FoSjcKkI\" />\n<input data-drupal-selector=\"edit-imu-header-search-form\" type=\"hidden\" name=\"form_id\" value=\"imu_header_search_form\" />\n\n</form>\n\n    <div class=\"search__icon\" id=\"search-toggle\">\n        </div>\n</div>\n<div id=\"block-cdc-breadcrumbs\" class=\"block-cdc-breadcrumbs\">\n  \n    \n        <nav role=\"navigation\" aria-labelledby=\"system-breadcrumb\">\n    <h2 id=\"system-breadcrumb\" class=\"visually-hidden\">Breadcrumb</h2>\n    <ol>\n          <li>\n                  Grants\n              </li>\n          <li>\n                  <a href=\"/cdc/grants/research-travel-grants\">Grants for Research Visits</a>\n              </li>\n          <li>\n                  Abel Visiting Scholar Program\n              </li>\n        </ol>\n  </nav>\n\n  </div>\n\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n\n  <div class=\"neat-container\">\n    <div class=\"neat-row main-aside-wrap\">\n\n      <main>\n        \n    <div data-drupal-messages-fallback class=\"hidden\"></div><div id=\"block-pagetitle\" class=\"block-pagetitle\">\n  \n    \n      \n  <h1>Abel Visiting Scholar Program</h1>\n\n\n  </div>\n\n                                            \n                                                                                            \n                <div class=\"main-section main__intro\"  class=\"wysiwyg-wrapper\"><div class=\"tex2jax_process\"><p class=\"img-third\"><img style=\"max-width:100%;\" alt=\"Logo.png\" height=\"250\" src=\"/fileadmin/CDC/Grants/Abel%20Visiting%20Scholar%20Program/Logo.png\" width=\"288\" loading=\"lazy\"></p><p class=\"img-third\">The Abel Visiting Scholar Program is intended for mathematicians professionally based in developing countries to visit an international research collaborator&nbsp;<strong>for a period of one month.</strong> For visits that are longer than one month, applicants must provide evidence of financial support from the host institution to cover the living expenses beyond the first month.</p><p>From 2013-2025 program was designed for post doctoral mathematicians in the early stages of&nbsp;their professional careers to offer the opportunity for a \u2018research sabbatical,\u2019 a necessary complement to teaching and other academic duties for mathematicians desiring to also sustain a viable research program. Usually up to 3 Grants were&nbsp;available per year.</p><p>Since 2026 the Program is intended for graduate students based in developing countries, who have finished at least 2 years of their PhD on the date of the application deadline or immediately following their PhD completion (max. 2 years after the defense) and who are under the age of 35. Priority will be give to students having submitted at least one paper to an international peer-reviewed journal.&nbsp;<br><a href=\"https://www.mathunion.org/cdc/grants/AVSPGS\">Here</a> you can find information how to apply to the new Abel Visiting Scholar Program for Graduate Students, deadlines etc.. .&nbsp;</p><p>The Abel Visiting Scholar Program is fully funded by the <a href=\"http://www.abelprize.no\">Abel Prize</a> in mathematics and is administered by the Commission for Developing Countries of the International Mathematical Union.</p><p>&nbsp;</p></div></div>\n        \n\n\n<section class=\"main-section divider paragraph paragraph--type--section-with-lists paragraph--view-mode--default\">\n  \n\n                        <h2 class=\"section-title\"> Abel Visiting Scholar Recipients</h2>\n                                \n\n<div class=\"list list--three neat-container paragraph paragraph--type--list-container paragraph--view-mode--default\">\n            \n\n        <div class=\"neat-row\">\n            \n    <ul>\n        \n<div class=\"list__title\">\n        <li class=\"title\">2025</li>\n  \n  <li>\n    <a href=\"/cdc/grants/grants-research-visits/abel-visiting-scholar-program/abel-visiting-scholar-2025-recipients\">Click here</a>\n  </li>\n\n    </ul>\n\n    \n\n            \n    <ul>\n        \n<div class=\"list__title\">\n        <li class=\"title\">2024</li>\n  \n  <li>\n    <a href=\"/cdc/grants/AVSP/abel-visiting-scholar-2024-recipients\">Click here</a>\n  </li>\n\n    </ul>\n\n    \n\n            \n    <ul>\n        \n<div class=\"list__title\">\n        <li class=\"title\">2023</li>\n  \n  <li>\n    <a href=\"/cdc/grants/grants-research-visits/abel-visiting-scholar-program/abel-visiting-scholar-2023\">click here</a>\n  </li>\n\n    </ul>\n\n        </div>\n    \n\n        <div class=\"neat-row\">\n            \n    <ul>\n        \n<div class=\"list__title\">\n        <li class=\"title\">2022</li>\n  \n  <li>\n    <a href=\"/cdc/grants/grants-research-visits/abel-visiting-scholar-program/abel-visiting-scholar-2022\">click here</a>\n  </li>\n\n    </ul>\n\n    \n\n            \n    <ul>\n        \n<div class=\"list__title\">\n        <li class=\"title\">2021</li>\n  \n  <li>\n    <a href=\"/cdc/grants/grants-research-visits/abel-visiting-scholar-program/abel-visiting-scholar-2021-recipients\">Click here</a>\n  </li>\n\n    </ul>\n\n    \n\n            \n    <ul>\n        \n<div class=\"list__title\">\n        <li class=\"title\">2020</li>\n  \n  <li>\n    <a href=\"/cdc/grants/grants-research-visits/abel-visiting-scholar-program/abel-visiting-scholar-2020-recipients\">Click here</a>\n  </li>\n\n    </ul>\n\n        </div>\n    \n\n        <div class=\"neat-row\">\n            \n    <ul>\n        \n<div class=\"list__title\">\n        <li class=\"title\">2019</li>\n  \n  <li>\n    <a href=\"/cdc/abel-visiting-scholar-2019-recipients\">Click here</a>\n  </li>\n\n    </ul>\n\n    \n\n            \n    <ul>\n        \n<div class=\"list__title\">\n        <li class=\"title\">2018</li>\n 