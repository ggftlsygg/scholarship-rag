iv>\n\n            <div class=\"faculty\">\n                <i class=\"fa fa-university\"></i> Faculty of Modern and Medieval Languages and Linguistics\n            </div>\n\n            <div class=\"fees\">\n                <span>\n                    \u00a311,700 / year\n                </span>\n            </div>\n\n            <div class=\"share\">\n                <i class=\"fa fa-share-alt\"></i>\n            </div>\n\n        </div><button id=\"rf:j_idt739\" name=\"rf:j_idt739\" class=\"ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only more pgf-btn\" type=\"submit\"><span class=\"ui-button-text ui-c\">Load More</span></button><script id=\"rf:j_idt739_s\" type=\"text/javascript\" nonce=\"NTlmMmE5ZWQtYWUwYy00NDBiLWEzYjAtOTE3N2JkZjM1YjVi\">$(function(){PrimeFaces.cw(\"CommandButton\",\"widget_rf_j_idt739\",{id:\"rf:j_idt739\"});});</script>\n\n    </div>\n            </div>\n\n        <a id=\"back2Top\" title=\"Back to top\" href=\"#\"></a><script type=\"text/javascript\" src=\"/javax.faces.resource/js/libs/back2top.min.js.xhtml;jsessionid=98A06EEC6AAAED701DB330DCB0602B3E?ln=custom\" nonce=\"NTlmMmE5ZWQtYWUwYy00NDBiLWEzYjAtOTE3N2JkZjM1YjVi\"></script><input type=\"hidden\" name=\"javax.faces.ViewState\" id=\"j_id1:javax.faces.ViewState:1\" value=\"-5389275159811019806:6387948763384066142\" autocomplete=\"off\" />\n</form>\n                    \n                </section>\n\n                <footer>\n\n    <div id=\"footer\">\n        <div class=\"section\">\n            <div class=\"footer-top clearfix\" style=\"position: relative\">\n\n                <div class=\"p-grid\">\n                    <div class=\"p-col-12 p-sm-6\"><img id=\"j_idt750\" src=\"/javax.faces.resource/images/cu-logo-bw-r.png.xhtml;jsessionid=98A06EEC6AAAED701DB330DCB0602B3E?ln=custom\" alt=\"\" class=\"logo\" />\n                        <span class=\"copyright\">\u00a9 2026 University of Cambridge</span>\n\n        <div class=\"build-info\" style=\"color: #FFFFFF;\">\n