.js\"></script>-->\n    <script src=\"/assets/js/libs/jquery/jquery-3.6.0.min.js\"></script>\n                        <link href=\"/research/css/research.css\" media=\"screen\" rel=\"stylesheet\" type=\"text/css\" />\n        <link href=\"/assets/css/cyclone-override.css\" media=\"screen\" rel=\"stylesheet\" type=\"text/css\" />            </head>\n<body id=\"us-body\" class=\"algae \">\n\n\n\n<div id=\"cookie-options\" class=\"cdc-container with-options\" data-nosnippet>\r\n    <div aria-describedby=\"cookieconsent:desc\" aria-label=\"cookieconsent\" aria-live=\"polite\" class=\"cdc-inner\" role=\"dialog\" style=\"\">\r\n        <!--googleoff: all-->\r\n        <div class=\"cdc-message\" id=\"cookieconsent:desc\">\r\n            <h2>Cookies on our website</h2>\r\n            <p>We use some essential cookies to make this website work.</p>\r\n            <p>We'd like to set additional cookies to understand how you use our site so we can improve it for everyone. Also, we'd like to serve you some cookies set by other services to show you relevant content.</p>\r\n            <a class=\"cdc-link\" href=\"https://www.sussex.ac.uk/about/website/privacy-and-cookies\" rel=\"noopener noreferrer nofollow\" role=\"button\" tabindex=\"0\" target=\"_blank\">View our privacy policy.</a>\r\n        </div>\r\n        <div class=\"cookie-buttons\">\r\n            <button class=\"cdc-choice cdc-reject\" tabindex=\"0\">Reject all</button>\r\n            <button class=\"cdc-choice cdc-accept\" tabindex=\"0\">Accept all</button>\r\n        </div>\r\n        <!--googleon: all-->\r\n    </div>\r\n</div>\r\n<noscript>\r\n    <style>\r\n    .cdc-container {\r\n        opacity: 1;\r\n        visibility: visible;\r\n    }\r\n    </style>\r\n</noscript>\r\n\n<header class=\"header\" role=\"banner\">\n    <div class=\"row\">\n        <div class=\"small-12 columns\">\n            <div class=\"logo\"><a href=\"/\"><span class=\"show-for-sr\">University of Sussex</span></a></div>\n            <nav 