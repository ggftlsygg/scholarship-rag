document).mouseup(function (e) {\n        var container = $(\"#GestioneProfilo\");\n        var id = $(\"#dropMenu\");\n        var myDiv = document.getElementById('GestioneProfilo');\n        \n        if (!container.is(e.target) && container.has(e.target).length === 0) {\n            if (myDiv.style.display == 'none' && !id.is(e.target) && id.has(e.target).length === 1) {\n                container.show();\n                myDiv.style.display = 'block';\n            } else { \n                container.hide();\n                myDiv.style.display = 'none';\n            }\n        } else {\n            container.show();\n            myDiv.style.display = 'block';\n        }\n    });\n</script>\n\n\n   ", "http_status": 200, "error": "", "final_url": "https://studyinitaly.esteri.it/ListaBandi"}