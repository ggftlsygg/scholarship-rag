_VMitsYWBM_nQkxk9z3M9Vg1euH0KNyeE.js?scope=footer&amp;delta=4&amp;language=en&amp;theme=nyu_law&amp;include=eJxtikEOwkAIAD9E5EkbyiIhRWgoxtTX20s9GE8zmQyvMq2zBjFnTcvAr93uldESE7jofYgqXgLyHJy5mpx4bG4ULPgvgmaqy6AgP9p4x98AWRQqqJ4LOezW8rJ5Di7VaGH9AUBNQW0\"></script>\n\n</body>\n</html>\n", "http_status": 200, "error": "", "final_url": "https://www.law.nyu.edu/jdadmissions/financial-support"}